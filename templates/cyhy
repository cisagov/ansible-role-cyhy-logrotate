# Default log rotation / compression keeps 1 year of logs.
/var/log/cyhy/*.log {
    su {{ cyhy_logrotate_log_username }} {{ cyhy_logrotate_log_group }}
    daily
    rotate 365
    dateext
    copytruncate
    delaycompress
    compress
    notifempty
    extension gz
    sharedscripts
    missingok
}
